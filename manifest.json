{
  "manifest_version": 3,
  "name": "QA Context Snapper",
  "version": "0.1.0",
  "description": "Capture environment data, recent UI interactions and console errors, then generate a Markdown bug report and a Playwright test script.",
  "minimum_chrome_version": "123",
  "action": {
    "default_title": "QA Context Snapper",
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/content-script.ts"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "permissions": ["activeTab", "downloads", "scripting", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "toggle-recording": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Start or stop a QA Context Snapper recording"
    },
    "toggle-assertion-mode": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Pick an element to assert on while recording"
    }
  }
}
